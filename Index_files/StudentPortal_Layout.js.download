var CheckOnlineRegistrationStatusNewForm = function (datee) {
    $.ajax({
        url: '/StudentOnlineRegistation/CheckOnlineRegistrationStatusNewForm',
        dataType: 'json',
        type: 'POST',
        success: function (data) {
            var html = '';
            if (data.OnlineRegistrationConfigId > 0) {
                if (data.SYTYInstructionId == 1) {
                    if (data.IsConfirm == true) {
                        html += '<li><a class="nav-link lvl-2-nav" id="InstructionSYTY" href="#"><span>Instruction </span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(false) + ' fa-' + GetLabel_1(false) + '"></i>';
                    }
                    else {
                        html += '<li><a class="nav-link lvl-2-nav" id="InstructionSYTY" href="/SYTYInstruction/SYTYInstruction"><span>Instruction </span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(true) + ' fa-' + GetLabel_1(true) + '"></i>';
                    }
                }
                $.each(data.Pages, function (key, item) {
                   
                    html += '<li><a class="nav-link lvl-2-nav" id="' + item.formname + 'SYTY" href="' + item.MenuLink + '"><span>' + item.formname + '</span><div class="text-align-last"><i id="iPersonal" class="fa text-'+ GetLabel(item.StudLinkStatus) +' fa-' + GetLabel_1(item.StudLinkStatus) + '"></i></div></a></li>';
                });
                }
                else {
                html += '<ul class="nav nav-list"><li class="menu-back"><a href="#"><i class="fa fa-ban" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Registration Closed</span></a></li>';
                if (data.IsConfirm == true) {
                    if (data.R8 == true) {
                        html += '<li class="menu-back"><a href="/StudentOnlineRegistation/OnlineRegistrationConfirmationAppPrint"><i class="fa fa-print" aria-hidden="true"></i><span class="submenuss">Application Print</span><span class="label label-' + GetLabel(data.IsConfirm) + ' pull-right"><i id="iPrint" class="fa fa-' + GetLabel_1(data.IsConfirm) + '"></i></span></a></li>';
                    }

                }
                html += '</li>';
            }
            $('#toggleDemo2').append(html);
        }
    });

    // NEP SUbject 
    $.ajax({
        url: '/NEPEvenCourseConfirm/GetNepSubjectOnlReg',
        dataType: 'json',
        type: 'POST',
        success: function (data) {

            //alert(JSON.stringify(data.R2))

            var html = '';
            if (data.OnlineRegistrationConfigId > 0) {
                if (data.IsConfirm == true) {
                    html += '<li><a class="nav-link lvl-2-nav" id="' + 'NEP Subject' + 'SYTY" href="' + '#' + '"><span>' + 'NEP Subject' + '</span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(false) + ' fa-' + GetLabel_1(false) + '"></i></div></a></li>';
                    html += '<li><a class="nav-link lvl-2-nav" id="' + 'Confirm Application' + 'SYTY" href="' + '#' + '"><span>' + 'Confirm Application' + '</span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(false) + ' fa-' + GetLabel_1(false) + '"></i></div></a></li>';
                    html += '<li><a class="nav-link lvl-2-nav" id="' + 'Print Application' + 'SYTY" href="' + '/NEPEvenCourseConfirm/PrintApplication' + '"><span>' + 'Print Application' + '</span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(data.IsConfirm) + ' fa-' + GetLabel_1(data.IsConfirm) + '"></i></div></a></li>';
                }
                else {
                    html += '<li><a class="nav-link lvl-2-nav" id="' + 'NEP Subject' + 'SYTY" href="' + '/NEPMajorEvenCourseSubject/Index' + '"><span>' + 'NEP Subject' + '</span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(true) + ' fa-' + GetLabel_1(true) + '"></i></div></a></li>';
                    html += '<li><a class="nav-link lvl-2-nav" id="' + 'Confirm Application' + 'SYTY" href="' + '#' + '"><span>' + 'Confirm Application' + '</span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(false) + ' fa-' + GetLabel_1(false) + '"></i></div></a></li>';
                    html += '<li><a class="nav-link lvl-2-nav" id="' + 'Print Application' + 'SYTY" href="' + '/NEPEvenCourseConfirm/PrintApplication' + '"><span>' + 'Print Application' + '</span><div class="text-align-last"><i id="iPersonal" class="fa text-' + GetLabel(data.IsConfirm) + ' fa-' + GetLabel_1(data.IsConfirm) + '"></i></div></a></li>';
                }
            }
            else {
                html += '<ul class="nav nav-list"><li class="menu-back"><a href="#"><i class="fa fa-ban" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Registration Closed</span></a></li>';
            }
            $('#toggleNEPEvenCourse').append(html);
        }

    });
};

// END

var CheckStudentAccessForItle = function () {

    $('#Itle_Student_Layout').hide();
    $.ajax({
        url: '/StudentOnlineRegistation/CheckCollegeApplicable',
        dataType: 'json',
        type: 'POST',
        success: function (data) {

            if (data == 1) {

                $('#Itle_Student_Layout').show();
            }
            else {
                $('#Itle_Student_Layout').hide();
            }

        }

    })


}

function GetLabel(valuess) {
    switch (valuess) {
        case true:
            return "success";
        case false:
            return "danger";
    }
}

function GetLabel_1(valuess) {
    switch (valuess) {
        case true:
            return "check-square";
        case false:
            return "square";
    }
}

