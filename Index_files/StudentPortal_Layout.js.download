function logout() {
    if (confirm("Are you sure you want to logout!")) {
        $.ajax({
            url: '/StudentLogin/ApplicationLogout',
            type: "GET",
            success: function (data) {
            },
            error: function (err) {
                toastr.warning('Something went wrong!', 'Warning!');
            }
        });
    }
    else {
        return false;
    }
}
var CheckOnlineRegistrationStatus = function (datee) {
    $.ajax({
        url: '/StudentOnlineRegistation/CheckOnlineRegistrationStatus',
        dataType: 'json',
        type: 'POST',
        success: function (data) {

            //alert(JSON.stringify(data.R2))

            var html = '';
            if (data.OnlineRegistrationConfigId > 0) {
                //html += '<li><a href="#" data-toggle="collapse" data-target="#toggleDemo2" data-parent="#sidenav01" class="collapsed"><span class="fa fa-registered"></span>Online Registation<span class="caret pull-right" style="margin-top: 7px;"></span></a>';
                //html += '<div class="collapse" id="toggleDemo2" style="height: 0px; margin-left: 12px;">';

                html += '<ul class="nav nav-list"><li class="menu-back"><a href="/StudentOnlineRegistation/PersonalDetails"><i class="fa fa-user" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Personal</span><span class="label label-' + GetLabel(data.L1) + ' pull-right"><i id="iPersonal" class="fa fa-' + GetLabel_1(data.L1) + '"></i></span></a></li>';
               
                html += '<li class="menu-back"><a href="/StudentOnlineRegistation/AddressDetails"><i class="fa fa-map-marker" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Address</span><span class="label label-' + GetLabel(data.L2) + ' pull-right"><i id="iAddress" class="fa fa-' + GetLabel_1(data.L2) + '"></i></span></a></li>';
                
                html += '<li class="menu-back"><a href="/StudentOnlineRegistation/PhotoAndSignatureDetails"><i class="fa fa-photo" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Photo/Sign</span><span class="label label-' + GetLabel(data.L3) + ' pull-right"><i id="iPhoto" class="fa fa-' + GetLabel_1(data.L3) + '"></i></span></a></li>';
                
                html += '<li class="menu-back"><a href="/StudentOnlineRegistation/ExamAttendanceDetails"><i class="fa fa-book" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Exam Details</span><span class="label label-' + GetLabel(data.L6) + ' pull-right"><i id="iExam" class="fa fa-' + GetLabel_1(data.L6) + '"></i></span></a></li>';
                
                html += '<li class="menu-back"><a href="/StudentOnlineRegistation/SubjectDetails"><i class="fa fa-book" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Subject</span><span class="label label-' + GetLabel(data.L5) + ' pull-right"><i id="iSubject" class="fa fa-' + GetLabel_1(data.L5) + '"></i></span></a></li>';
                
                html += '<li class="menu-back"><a href="/StudentOnlineRegistation/Confirm"><i class="fa fa-check-circle" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Confirm</span><span class="label label-' + GetLabel(data.IsConfirm) + ' pull-right"><i id="iConfirm" class="fa fa-' + GetLabel_1(data.IsConfirm) + '"></i></span></a></li>';
                
                html += '<li class="menu-back"><a href="/StudentOnlineRegistation/OnlineRegistrationConfirmation"><i class="fa fa-print" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Application Print</span><span class="label label-' + GetLabel(data.IsConfirm) + ' pull-right"><i id="iPrint" class="fa fa-' + GetLabel_1(data.IsConfirm) + '"></i></span></a></li></ul></div></li>';
            }
            else {
                html += '<ul class="nav nav-list"><li class="menu-back"><a href="#"><i class="fa fa-ban" aria-hidden="true"></i><span class="submenuss" style="font-style: italic">Registration Closed</span></a></li>';
                html += '</ul></div></li>';
            }
            $('#toggleDemo2').append(html);
        }
    });
};

